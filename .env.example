# Data Hive — пример конфигурации
# Скопировать в .env и заполнить значениями

# ── Telegram ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_token_here
ADMIN_ID=123456789

# ── Пути ─────────────────────────────────────────────────
USER_NAME=lexey
USERS_DIR=users
DOWNLOADS_DIR=downloads

# ── Whisper ───────────────────────────────────────────────
WHISPER_MODEL=small
WHISPER_THREADS=16
WHISPER_COMPUTE_TYPE=int8

# ── Ollama ────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_MODEL_COMPLEX=qwen2.5:7b

# ── Webhook ───────────────────────────────────────────────
WEBHOOK_MODE=true
WEBHOOK_LISTEN=127.0.0.1
WEBHOOK_PORT=8080
WEBHOOK_PUBLIC_URL=https://yourdomain.example.com
WEBHOOK_PATH=bot_datahive
WEBHOOK_SECRET_TOKEN=generate_random_secret_here

# ── HikerAPI (Instagram) ──────────────────────────────────
HIKERAPI_TOKEN=your_hikerapi_token_here
