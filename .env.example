# Data Hive — пример конфигурации
# Скопировать в .env и заполнить значениями

# ── Telegram ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_token_here
ADMIN_ID=123456789

# ── Пути ─────────────────────────────────────────────────
USER_NAME=lexey
USERS_DIR=users
DOWNLOADS_DIR=downloads

# ── Whisper ───────────────────────────────────────────────
WHISPER_MODEL=small
WHISPER_THREADS=16
WHISPER_COMPUTE_TYPE=int8

# ── Ollama ────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_MODEL_COMPLEX=qwen2.5:7b

# ── HikerAPI (Instagram) ──────────────────────────────────
HIKERAPI_TOKEN=your_hikerapi_token_here
