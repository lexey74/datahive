# Data Hive — пример конфигурации
# Скопировать в .env и заполнить значениями

# ── Telegram ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_token_here
ADMIN_ID=123456789

# ── Пути ─────────────────────────────────────────────────
USER_NAME=lexey
USERS_DIR=users
DOWNLOADS_DIR=downloads

# ── Whisper ───────────────────────────────────────────────
WHISPER_MODEL=small
WHISPER_THREADS=16
WHISPER_COMPUTE_TYPE=int8

# ── Ollama ────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_MODEL_COMPLEX=qwen2.5:7b

# ── Webhook (production) ──────────────────────────────────
WEBHOOK_MODE=false
WEBHOOK_LISTEN=127.0.0.1
WEBHOOK_PORT=8080
WEBHOOK_PUBLIC_URL=https://datahive.inno.co
WEBHOOK_PATH=bot_changeme
WEBHOOK_SECRET_TOKEN=generate_random_secret_here

# ── MCP SSE сервер ────────────────────────────────────────
MCP_HOST=127.0.0.1
MCP_PORT=8000
PUBLIC_MCP_URL=https://datahive.inno.co/mcp
MCP_JWT_SECRET=generate_random_jwt_secret_here
MCP_DEV_MODE=false
DEFAULT_MCP_USER=

# ── CORS/Hosts ────────────────────────────────────────────
FASTMCP_ALLOW_HOSTS=datahive.inno.co,localhost,127.0.0.1
FASTMCP_ALLOW_ORIGINS=https://datahive.inno.co,http://localhost:*,http://127.0.0.1:*

# ── HikerAPI (Instagram) ──────────────────────────────────
HIKERAPI_TOKEN=your_hikerapi_token_here
