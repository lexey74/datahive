# Data Hive — пример конфигурации
# Скопировать в .env и заполнить значениями

# ── Telegram ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_token_here
ADMIN_ID=123456789

# ── Пути ─────────────────────────────────────────────────
USER_NAME=lexey
USERS_DIR=users
DOWNLOADS_DIR=downloads

# ── Whisper ───────────────────────────────────────────────
WHISPER_MODEL=small
WHISPER_THREADS=4
WHISPER_COMPUTE_TYPE=int8
# Если пусто — faster-whisper запускается in-process (режим без Docker).
# Для Docker: docker-compose переопределяет на http://whisper:9000 автоматически.
WHISPER_URL=
# API-ключ доступа к whisper-сервису (Bearer-токен).
# Генерация: openssl rand -hex 32
# Если пусто — авторизация отключена (только внутри Docker-сети).
WHISPER_API_KEY=
# Выгружать модель из RAM через N минут простоя (0 = никогда)
WHISPER_IDLE_TIMEOUT=30
# Загрузить модель при старте (false = загрузка только по первому запросу)
WHISPER_PRELOAD=true

# ── Ollama ────────────────────────────────────────────────
# Для Docker: docker-compose переопределяет на http://ollama:11434 автоматически.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_MODEL_COMPLEX=qwen3:4b
# Выгружать модель из VRAM/RAM через N минут/часов простоя.
# Примеры: 5m, 1h, 0 (никогда не выгружать)
OLLAMA_KEEP_ALIVE=5m
# API-ключ доступа к ollama через Caddy (Bearer-токен).
# Генерация: openssl rand -hex 32
OLLAMA_API_KEY=

# ── Webhook ───────────────────────────────────────────────
WEBHOOK_MODE=true
WEBHOOK_LISTEN=127.0.0.1
WEBHOOK_PORT=8080
WEBHOOK_PUBLIC_URL=https://yourdomain.example.com
WEBHOOK_PATH=bot_datahive
WEBHOOK_SECRET_TOKEN=generate_random_secret_here

# ── HikerAPI (Instagram) ──────────────────────────────────
HIKERAPI_TOKEN=your_hikerapi_token_here
